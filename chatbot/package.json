{
  "name": "vem-pra-orla-chatbot",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Bot de WhatsApp que envia todo dia as condições da orla para os grupos em que o número participa",
  "scripts": {
    "start": "tsx src/index.ts",
    "enviar-agora": "tsx src/index.ts --agora",
    "listar-grupos": "tsx src/index.ts --listar-grupos",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "node-cron": "^4.6.0",
    "qrcode-terminal": "^0.12.0",
    "tsx": "^4.23.15",
    "whatsapp-web.js": "^1.34.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "typescript": "^6.0.2"
  }
}
